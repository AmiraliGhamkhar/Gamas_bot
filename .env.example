# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# api_id و api_hash از my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# شناسه‌های عددی مدیرها، جداشده با کاما
ADMIN_IDS=123456789

# --- طرح‌ها و پرداخت کارت‌به‌کارت ---
# فقط عدد صحیح (ساعت/تومان/روز)؛ حسابداری داخلی با ثانیهٔ صحیح است (ساعت × ۳۶۰۰).
# طرح رایگان فقط یک بار برای هر کاربر و بدون انقضا داده می‌شود؛ /start آن را تمدید نمی‌کند.
# تغییر این مقادیر فقط روی خریدها/عضویت‌های بعدی اثر دارد (اعتبارهای قبلی snapshot هستند).
FREE_PLAN_HOURS=1
PLAN_25_HOURS=25
PLAN_25_PRICE_TOMAN=150000
PLAN_25_VALIDITY_DAYS=30
PLAN_50_HOURS=50
PLAN_50_PRICE_TOMAN=250000
PLAN_50_VALIDITY_DAYS=30
# مقصد پرداخت؛ شماره در برنامه فقط به صورت ۱۶ رقم نرمال‌شده نگه داشته می‌شود.
PAYMENT_CARD_NUMBER=5022291332906625
PAYMENT_CARD_HOLDER=امیرعلی غمخوار
PAYMENT_BANK_NAME=بانک پاسارگاد
# رسیدها بیرون از web root، با مجوز پوشهٔ 700 و فایل 600 نگهداری می‌شوند.
RECEIPT_DIR=data/receipts
RECEIPT_RETENTION_DAYS=90
MAX_PAYMENT_RECEIPT_BYTES=5000000

# کلید اصلی رمزگذاری credentialها را از environment وارد کنید؛ در SQLite فقط ciphertext ذخیره می‌شود.
# آن را ثابت نگه دارید و جداگانه، رمز‌شده پشتیبان بگیرید؛ با گم‌شدن کلید، API keyهای دیتابیس بازیابی نمی‌شوند.
# ساخت یک کلید تازه: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# حداقل یکی از کلیدهای Speechmatics/Deepgram یا نشانی STT سازگار با OpenAI لازم است
SPEECHMATICS_API_KEY=
DEEPGRAM_API_KEY=
# موتور اصلی: speechmatics، deepgram یا openai_compatible
STT_PRIMARY=speechmatics
# زبان پیاده‌سازی گفتار. مقدار می‌تواند یک کد زبان (fa، en، en-US)، یک بستهٔ
# دوزبانهٔ Speechmatics (مثل ar_en) یا یکی از دو کلیدواژهٔ زیر باشد. معنايش
# وابسته به سرویس است و در لایهٔ هر سرویس ترجمه می‌شود:
#   auto  = تشخیص خودکار زبان (در Speechmaticsِ enhanced/standard؛ دیپ‌گرام ندارد)
#   multi = مدل چندزبانه (در Speechmatics فقط برای melia-1/oak-1؛ در دیپ‌گرام
#           فقط برای nova-2/nova-3 و بدون پوشش فارسی)
# زبان تشخیص گفتار. مقدار می‌تواند یک کد زبان (fa، en-US)، یک بستهٔ دوزبانهٔ
# Speechmatics (ar_en، cmn_en_ms_ta) یا یکی از کلیدواژه‌های auto/multi باشد.
# معنای هر کلیدواژه برای هر سرویس فرق می‌کند (مستندات را ببینید):
#   Speechmatics enhanced/standard: auto = تشخیص خودکار زبان
#   Speechmatics melia-1/oak-1    : فقط multi (auto خطا می‌گیرد)
#   دیپ‌گرام                      : auto ندارد؛ multi فقط در مدل‌های چندزبانه
#                                   و بدون فارسی (en, es, fr, de, hi, ru, pt,
#                                   ja, it, nl)
#   سازگار با OpenAI              : auto = فیلد language فرستاده نمی‌شود
# (جزوه همیشه به فارسی ساخته می‌شود؛ این فقط زبان تشخیص گفتار است)
STT_LANGUAGE=fa
STT_FALLBACK_ENABLED=true
# در صورت confidence کمتر از این مقدار، موتور جایگزین امتحان می‌شود
STT_MIN_CONFIDENCE=0.65
# تلاش مجدد برای خطاهای گذرا (429/5xx/شبکه/اتمام زمان) پیش از رفتن به سرویس بعدی
STT_MAX_ATTEMPTS=3
# بازگشت نمایی محدود میان تلاش‌ها (ثانیه)؛ مقدار Retry-After سرویس مقدم است
STT_RETRY_BASE_DELAY_SECONDS=2
STT_RETRY_MAX_DELAY_SECONDS=30
# فقط در صورت نیاز به تغییر منطقهٔ Speechmatics تنظیم شود
SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2
# مدل Speechmatics (همان operating point در مستندات سرویس):
#   enhanced = بیشترین دقت (پیش‌فرض)    standard = توان بالاتر، دقت کمتر
#   melia-1  = چندزبانه با تشخیص و جابه‌جایی خودکار زبان (batch)
#   oak-1    = چندزبانهٔ حوزهٔ سلامت (batch)
# melia-1 و oak-1 فرهنگ اصطلاحات و confidence نمی‌دهند و با auto خطا می‌گیرند.
SPEECHMATICS_OPERATING_POINT=enhanced
# نام قدیمی همان تنظیم؛ فقط وقتی SPEECHMATICS_OPERATING_POINT خالی باشد خوانده می‌شود
# SPEECHMATICS_MODEL=enhanced
# نام فیلدی که انتخاب بالا با آن فرستاده می‌شود: model (پیش‌فرضِ مستندات فعلی)،
# operating_point (نام منسوخ؛ برای کانتینرهای batch قدیمی) یا both.
SPEECHMATICS_MODEL_FIELD=model
# فرهنگ اصطلاحات سفارشی Speechmatics (اسامی دارو و واژگان فنی)؛ جدا با کاما یا «،».
# ترتیب نوشتن همان ترتیب اولویت است. سرویس برای هر کار حداکثر ۱۰۰۰ مدخل را
# توصیه می‌کند و بالای ۲۰۰۰۰ مدخل کار را رد می‌کند.
SPEECHMATICS_ADDITIONAL_VOCAB=
# بیشترین تعداد مدخل فرستاده‌شده در هر کار (۱ تا ۲۰۰۰۰؛ پیش‌فرض ۱۰۰۰)
SPEECHMATICS_VOCAB_MAX_ITEMS=1000
# مدل دیپ‌گرام. language=fa یعنی فقط فارسی (تک‌زبانه)؛ حالت multi در nova-3
# شامل فارسی نیست، پس «فارسی+انگلیسی خودکار» با این سرویس پشتیبانی نمی‌شود.
DEEPGRAM_MODEL=nova-3
# --- STT سازگار با OpenAI (اختیاری): OpenAI whisper-1، Groq، vLLM/Ollama محلی ---
# با خالی بودن نشانی، این سرویس وجود ندارد؛ کلید برای سرویس محلی لازم نیست
STT_OPENAI_BASE_URL=
STT_OPENAI_API_KEY=
STT_OPENAI_MODEL=whisper-1
# فایل‌های بزرگ‌تر از این مقدار به این سرویس فرستاده نمی‌شوند (پیش‌فرض ۲۵MB)
STT_OPENAI_MAX_UPLOAD_BYTES=25000000

# --- API تولید جزوه ---
# گزینه‌ها: gemini، openai_compatible، anthropic یا disabled
# openai_compatible با OpenAI، OpenRouter، Groq، Together، DeepSeek، Ollama، vLLM و
# هر سرویس دارای endpoint سازگار با /chat/completions کار می‌کند؛ یعنی دقیقاً همین
# قرارداد: درخواست {model, messages, temperature, max_tokens} و پاسخ
# {"choices":[{"message":{"content": "..."}}]}. سرویس‌هایی که این شکل را برنگردانند
# با پیام «ساختار پاسخ غیرمنتظره» رد می‌شوند.
NOTE_API_PROVIDER=gemini
# کلید عمومی سرویس؛ برای Gemini می‌توان به‌جای آن GEMINI_API_KEY را نگه داشت.
NOTE_API_KEY=
# برای Gemini خالی بماند. نمونه OpenAI: https://api.openai.com/v1
# نمونه OpenRouter: https://openrouter.ai/api/v1
NOTE_API_BASE_URL=
# اگر خالی باشد، مدل پیش‌فرض همان provider انتخاب می‌شود
# (gemini -> GEMINI_MODEL، anthropic -> claude-haiku-4-5،
#  openai_compatible -> gpt-4o-mini). برای Anthropic می‌توان شناسهٔ پین‌شده
# (مثل claude-haiku-4-5-20251001) را هم نوشت.
NOTE_API_MODEL=
# هدرهای سفارشی اختیاری به شکل JSON؛ برای systemd کل JSON را داخل تک‌کوتیشن بگذارید.
# هدرهای احراز هویت (Authorization، x-api-key، api-key، x-goog-api-key) رزرو شده‌اند
# و نادیده گرفته می‌شوند تا تنظیمات نتواند کلید سرویس را عوض کند.
# هرگز کلید محرمانه را اینجا commit نکنید. نمونه: '{"X-Title":"Gamas Bot"}'
NOTE_API_EXTRA_HEADERS_JSON={}
NOTE_API_TIMEOUT_SECONDS=240
NOTE_API_RETRIES=2
# پایان خروجی به‌علت سقف توکن باعث بازگشت محتوای خام می‌شود
NOTE_API_MAX_OUTPUT_TOKENS=8192
# فقط برای openai_compatible: فعال‌کردن response_format json_object.
# همهٔ سرویس‌های سازگار این گزینه را ندارند؛ پیش‌فرض همان پرامپت سخت‌گیرانهٔ JSON است.
NOTE_API_JSON_MODE=false
# حالت فشرده‌سازی جزوه: full (پیش‌فرض، حفظ جزئیات)، standard یا summary (فشرده‌سازی عمدی)
NOTE_MODE=full
# فعال‌سازی تلاش دوم برای اصلاح جزوه در صورت تشخیص مشکل در QA؛ با false غیرفعال می‌شود
NOTE_REPAIR_ENABLED=true
# لایهٔ زمینهٔ کلی درس: یک فراخوانی ارزان برای فهرست موضوع‌ها، ارسال همان
# زمینه به همهٔ بخش‌ها و یک ویرایش نهاییِ سراسری. با false رفتار تک‌بخشیِ
# قبلی برمی‌گردد (جزوه‌های تک‌بخشی از ابتدا فقط یک فراخوانی دارند).
NOTE_GLOBAL_CONTEXT_ENABLED=true

# سازگاری با تنظیمات نسخه‌های قبلی Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# پروکسی اختیاری فقط برای اتصال تلگرام (هاست‌هایی که MTProto را مسدود می‌کنند)
# نمونه: socks5://user:pass@host:1080 یا http://host:3128
# API سرویس‌های STT و جزوه مستقیم وصل می‌شوند و از این پروکسی استفاده نمی‌کنند.
TELEGRAM_PROXY=

# مسیرهای نسبی نسبت به پوشهٔ پروژه سنجیده می‌شوند، نه پوشهٔ جاری شل/cron
DATABASE_PATH=data/bot.sqlite3
TELEGRAM_SESSION_PATH=data/telegram_bot
TEMP_DIR=data/tmp
MAX_FILE_SIZE_BYTES=2000000000
# فقط کارهای فعال؛ صف منتظر محدود نیست و در حافظه است
# کارهای هم‌زمان (تعداد worker ثابت صف)
MAX_CONCURRENT_JOBS=3
# بیشترین تعداد کار منتظر در صف؛ بیش از این با پیام روشن رد می‌شود تا صف در حافظه
# بی‌انتها نشود (ظرفیت کل پذیرش = MAX_CONCURRENT_JOBS + MAX_PENDING_JOBS)
MAX_PENDING_JOBS=8
STT_POLL_INTERVAL_SECONDS=5
# سقف هر تلاش STT شامل آپلود، Poll و دریافت متن؛ Fallback بودجه جدا دارد
STT_JOB_TIMEOUT_SECONDS=21600

# --- پردازش فایل ارائه (PowerPoint) ---
# پذیرش فایل‌های pptx و استخراج صدای اسلایدها
PPTX_ENABLED=true
# استفاده از متن و یادداشت گویندهٔ اسلایدها در ساخت جزوه
PPTX_INCLUDE_SLIDE_TEXT=true
# استخراج صدا از ویدیوهای داخل اسلایدها
PPTX_INCLUDE_VIDEO_AUDIO=true
# پذیرش فایل‌های قدیمی ppt/pps/pot با تبدیل به pptx از طریق بستهٔ ppt2pptx
# (فرمت‌های odp/otp پشتیبانی نمی‌شوند و با پیام روشن رد می‌شوند)
PPTX_LEGACY_ENABLED=true
# کلیپ‌های کوتاه‌تر از این مقدار (ثانیه) نادیده گرفته می‌شوند؛ مثل صدای افکت اسلاید
PPTX_MIN_CLIP_SECONDS=1.0
# فاصلهٔ سکوت میان صدای اسلایدها هنگام ادغام (ثانیه)
PPTX_SILENCE_SECONDS=0.5
PPTX_MAX_CLIPS=300
# سقف مجموع مدت صداهای یک ارائه (ثانیه)
PPTX_MAX_TOTAL_DURATION_SECONDS=21600
# سقف حجم بازشدهٔ فایل ارائه برای جلوگیری از zip bomb
PPTX_MAX_UNPACKED_BYTES=4000000000
# اگر خروجی WAV بزرگ‌تر از این مقدار شود، به‌جای آن Opus ساخته می‌شود
PPTX_WAV_LIMIT_BYTES=700000000

# سقف زمان عملیات رسانه‌ای (ثانیه)؛ برای سازگاری، FFMPEG_TIMEOUT_SECONDS
# قدیمی نیز همچنان خوانده می‌شود
MEDIA_TIMEOUT_SECONDS=3600
# FFMPEG_TIMEOUT_SECONDS=3600  # متغیر قدیمی؛ MEDIA_TIMEOUT_SECONDS را استفاده کنید
# سقف زمان تبدیل PowerPoint قدیمی به pptx (ثانیه)؛ SOFFICE_TIMEOUT_SECONDS
# قدیمی نیز همچنان خوانده می‌شود
PPT_CONVERT_TIMEOUT_SECONDS=600
# SOFFICE_TIMEOUT_SECONDS=600  # متغیر قدیمی؛ PPT_CONVERT_TIMEOUT_SECONDS را استفاده کنید

# --- لاگینگ ---
LOG_LEVEL=INFO
# text یا json (برای Loki/ELK/Cloud Logging)
LOG_FORMAT=text
# روی systemd خالی بگذارید تا فقط journald استفاده شود؛ نمونه: data/logs/bot.log
LOG_FILE=
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5

# --- خروجی سند و پیشرفت ---
# فونت متن فارسی سند Word؛ Tahoma همه‌جا هست. اگر مخاطبانتان فونت را دارند،
# B Nazanin یا Vazirmatn را بگذارید.
DOCX_FONT=Tahoma
# پروفایل فونت: persian_modern (Vazirmatn + Aptos)، traditional (B Nazanin + Times New Roman)،
# legacy (فقط Tahoma) یا persian_modern_alt (Vazirmatn + Calibri).
# متغیرهای DOCX_FONT_* پایین بر پروفایل اولویت دارند.
DOCX_FONT_PROFILE=persian_modern
# فونت‌های تفکیکی برای نقش‌های مختلف؛ خالی گذاشتن یعنی استفاده از پروفایل انتخابی
# (نام هم‌ارز این چهار متغیر هم پذیرفته می‌شود: DOCX_BODY_FONT، DOCX_HEADING_FONT،
#  DOCX_LATIN_FONT، DOCX_FALLBACK_FONT)
DOCX_FONT_BODY=
DOCX_FONT_HEADING=
DOCX_FONT_LATIN=
DOCX_FONT_FALLBACK=Tahoma
# --- طراحی سند Word (جلد / فهرست / کادر صفحه / پاورقی) ---
# صفحهٔ جلد با «به نام خدا»، نشان گاماس و جملهٔ حکمت؛ خاموش‌کردن آن صفحهٔ
# جلد را حذف می‌کند و سند با بلوک عنوان شروع می‌شود.
DOCX_COVER_ENABLED=true
# فهرست مطالب ایستا با شمارهٔ صفحهٔ واقعی و پیوندهای داخلی (برای جزوه‌های کوتاه بی‌اثر است).
# برای جزوهٔ بلند، LibreOffice (soffice) و بستهٔ pypdf لازم است؛ اگر صفحه‌بندی دقیق
# در دسترس نباشد، سند دارای فهرست به‌جای درج شمارهٔ حدسی ساخته نمی‌شود.
DOCX_TOC_ENABLED=true
DOCX_PAGINATION_TIMEOUT_SECONDS=120
# Optional absolute path; blank uses `soffice` or `libreoffice` from PATH.
DOCX_PAGINATION_RENDERER_BIN=
# سطح‌های عنوان در فهرست: 1-1 یعنی فقط موضوع‌های اصلی درس (پیش‌فرض)؛ با 1-2
# زیرعنوان‌های هر بخش (تعریف‌ها، مثال‌ها، …) هم می‌آیند.
DOCX_TOC_LEVELS=1-1
# از این تعداد بخش به بعد فهرست ساخته می‌شود (و برای جزوهٔ بلند حتی با بخش کمتر).
DOCX_TOC_MIN_SECTIONS=4
# کادر سراسری صفحه (w:pgBorders واقعی در هر بخش)، سبک/رنگ/ضخامت و فاصله
DOCX_PAGE_BORDER_ENABLED=true
DOCX_PAGE_BORDER_STYLE=single
DOCX_PAGE_BORDER_COLOR=BFCEE4
DOCX_PAGE_BORDER_WIDTH=8
DOCX_PAGE_BORDER_SPACE=24
# نمایش نام برند در پاورقی (شمارهٔ صفحه همیشه با فیلد واقعی PAGE می‌آید)
DOCX_SHOW_FOOTER_BRAND=true
# لوگوی محلی اختیاری؛ خالی یعنی نشان تایپی GAMAS. تصویری از شبکه دانلود نمی‌شود
# و نبودِ فایل هرگز تولید سند را متوقف نمی‌کند.
DOCX_LOGO_PATH=
# انیمیشن نوار پیشرفت (چرخش هرنوبت پیام وضعیت)؛ با false فقط به‌روزرسانی مراحل واقعی می‌آید
PROGRESS_ANIMATION_ENABLED=true
