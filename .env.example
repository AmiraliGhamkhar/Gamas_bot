# Gamas Bot v3 configuration template.
# Copy to .env: Windows PowerShell: Copy-Item .env.example .env
# cPanel Terminal: cp .env.example .env && chmod 600 .env
# Keep .env, data, logs and receipts outside public_html; never commit or share secrets.
# Relative paths resolve from the project directory. Keys are not stored in SQLite.

# ── تلگرام (اجباری) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# نشست Telethon (پیش‌فرض: data/gamas)
#TELEGRAM_SESSION=data/gamas
# شناسه‌های عددی مدیرها، با ویرگول
ADMIN_IDS=

# ── مسیرها و لاگ ────────────────────────────────────────────────────────────
#DB_PATH=data/gamas_v3.db
#TEMP_DIR=data/tmp
#LOG_FILE=data/gamas.log
#LOG_LEVEL=INFO
#LOG_FORMAT=plain
#LOG_MAX_BYTES=5242880
#LOG_BACKUP_COUNT=5

# ── صف و زمان‌های انتظار ────────────────────────────────────────────────────
#MAX_FILE_SIZE=2147483648
#MAX_ACTIVE_JOBS=3
#MAX_QUEUED_JOBS=8
# تعداد کارهای هم‌زمانِ سنگین در PyAV/مبدل؛ پیش‌فرض محافظه‌کارانه ۱ است.
#MEDIA_WORKER_CONCURRENCY=1
#MEDIA_TIMEOUT=3600
#CONVERT_TIMEOUT=600
#STT_JOB_TIMEOUT=21600
#STT_POLL_INTERVAL=10

# ── تبدیل گفتار به متن (حداقل یکی اجباری) ─────────────────────────────────
# ترتیب failover؛ فقط سرویس‌های دارای کلید امتحان می‌شوند.
#STT_PROVIDERS=speechmatics,deepgram,openai_compatible
#STT_LANGUAGE=fa

SPEECHMATICS_API_KEY=
#SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
# مدل‌های مجاز: enhanced (پیش‌فرض) | standard | melia-1 | oak-1
# دو مدل آخر چندزبانه‌اند، فقط Batch، و به‌جای زبان کد «multi» را می‌گیرند
# (STT_LANGUAGE=multi)؛ مقدار auto را رد می‌کنند.
#SPEECHMATICS_MODEL=enhanced
# سقف آپلود مستقیم Speechmatics ۱GB است (POST /jobs)؛ فایل بزرگ‌تر به موتور بعدی می‌رود.

#DEEPGRAM_API_KEY=
#DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
# فارسی فقط روی nova-3 پشتیبانی می‌شود؛ nova-2 زبان fa ندارد و درخواست را
# با HTTP 400 رد می‌کند.
#DEEPGRAM_MODEL=nova-3

# هر نقطهٔ پایانی سازگار با OpenAI:
#STT_OPENAI_BASE_URL=https://api.openai.com/v1
#STT_OPENAI_API_KEY=
#STT_OPENAI_MODEL=whisper-1
# Official OpenAI transcription API is limited to 25 MB; raise for a gateway
# that documents a larger limit.
#STT_OPENAI_MAX_UPLOAD_BYTES=25000000

# ── تولید جزوه (اختیاری؛ بدون آن فقط متن خام تحویل می‌شود) ─────────────────
# ترتیب سرویس‌ها همین‌جا تعیین می‌شود و همان ترتیب failover است: هر سرویس فقط
# وقتی امتحان می‌شود که کلید خودش را داشته باشد. ترتیب پیش‌فرض پروژه:
#   gemini → nara → openrouter → groq → cerebras → (openai_compatible) → (anthropic)
# یعنی سریع‌ترین مسیر (Gemini flash-lite بدون تفکر) اول امتحان می‌شود و هر سرویسِ
# بدون کلید بی‌صدا از زنجیره حذف می‌شود؛ پس همین پیش‌فرض برای استقرارهای فعلی هم
# رفتار قبلی را حفظ می‌کند.
#NOTE_PROVIDERS=gemini,nara,openrouter,groq,cerebras

# ── پیش‌تنظیم سریع (توصیه‌شده) ──────────────────────────────────────────────
# با این مقادیر، تبدیل صوت به جزوه از حدود ۸ تا ۱۲ دقیقه (Nara تنها) به حدود
# ۱ تا ۲ دقیقه می‌رسد؛ تفکر Gemini خاموش است و درخواست‌های موازی/hedge زودتر
# سرویس دوم را شروع می‌کنند. اگر سرور در ایران است، پیش از فعال‌سازی دسترسی به
# generativelanguage.googleapis.com و api.groq.com را بررسی کنید.
#
#NOTE_PROVIDERS=gemini,nara,openrouter,groq,cerebras
#GEMINI_MODEL=gemini-2.5-flash-lite
#NOTE_GEMINI_THINKING_BUDGET=0
#NOTE_TTFB_TIMEOUT_SECONDS=25
#NOTE_HEDGE_AFTER_SECONDS=60
#NOTE_CONCURRENCY=6
#NOTE_REQUEST_TIMEOUT_SECONDS=300
#NOTE_REASONING_EFFORT=low
#NOTE_STRICT_GROUNDING=true

# Nara AI (NaraRouter) — مسیر دوم زنجیره (پشتیبان اول). کلید از پنل router.bynara.id گرفته می‌شود.
#NARA_API_KEY=
#NARA_BASE_URL=https://router.bynara.id/v1
# مدل پیش‌فرض همان مدل فهرست Free plan این سرویس است؛ برای مدل دیگر عوض کنید.
#NARA_MODEL=agnes-2.5-flash

# OpenRouter — مسیر سوم زنجیره.
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# مدل رایگانِ مشخص و ثابت (پنجرهٔ ۲۶۲۱۴۴ توکن، سقف خروجی ۳۲۷۶۸)؛ مسیریاب
# openrouter/free مدل را برای هر درخواست عوض می‌کند و پنجرهٔ واقعیِ پاسخ‌دهنده
# هنگام اندازه‌گیری درخواست معلوم نیست، برای همین پیش‌فرض پروژه نیست.
#OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Groq — مسیر OpenAI-compatible با سرعت بالا (gpt-oss). کلید از console.groq.com.
# سهمیهٔ رایگان: ۳۰ درخواست در دقیقه، ۱۰۰۰ درخواست در روز و سقف ۸۰۰۰ توکن در
# دقیقه؛ اگر Groq سرویس *اصلی* شماست، NOTE_CHUNK_CHARS=14000 و NOTE_CONCURRENCY=2
# بگذارید (تکهٔ بزرگ‌تر یا هم‌زمانی بیشتر از سقف TPM رد می‌شود).
#GROQ_API_KEY=
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — مسیر OpenAI-compatible با سریع‌ترین تولید توکن.
# سهمیهٔ رایگان فقط ۵ درخواست در دقیقه است؛ با NOTE_CONCURRENCY بالا تنش دارد،
# پس آن را به‌عنوان سرویس hedge/دوم نگه دارید نه اصلی.
#CEREBRAS_API_KEY=
#CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
#CEREBRAS_MODEL=gpt-oss-120b

# ── سرویس‌های دیگر (اختیاری؛ فقط اگر در NOTE_PROVIDERS فهرست شوند) ─────────
# openai_compatible | gemini | anthropic
# NOTE_PROVIDER همان اسلات تک‌سرویسی نسخهٔ قبل است: اگر تنظیم شده باشد، در
# ابتدای زنجیره می‌آید (و اگر NOTE_BASE_URL به یکی از سرویس‌های بالا اشاره کند،
# همان سرویس شناخته می‌شود). Gemini برای محیط قدیمی که فقط GEMINI_API_KEY دارد
# خودکار انتخاب می‌شود. برای Anthropic باید NOTE_MODEL را صریح بگذارید.
#NOTE_PROVIDER=openai_compatible
#NOTE_API_KEY=
# نام جدید همان کلید: فقط وقتی NOTE_API_KEY و NOTE_BASE_URL تنظیم نشده باشند،
# GEMINI_API_KEY به‌طور خودکار سرویس gemini را انتخاب می‌کند.
#GEMINI_API_KEY=
# مدل Gemini؛ flash-lite برای «استخراج و سازمان‌دهی» جزوه چند برابر سریع‌تر از
# مدل‌های thinking است و کیفیت فارسی‌اش برای این کار کافی است.
#GEMINI_MODEL=gemini-2.5-flash-lite
# بودجهٔ تفکر Gemini: ۰ تفکر را کامل خاموش می‌کند (کار جزوه استخراج است، پس
# توکن‌های تفکر فقط تأخیر می‌سازند)، عدد مثبت سقف توکن‌های تفکر است و ‎-۱‎ هیچ
# فیلد thinkingConfig نمی‌فرستد (رفتار پیش از این گزینه). مدلی که این فیلد را
# نپذیرد، یک‌بار بدون آن دوباره امتحان می‌شود.
#NOTE_GEMINI_THINKING_BUDGET=0
#NOTE_BASE_URL=https://api.openai.com/v1
#NOTE_MODEL=gpt-4o-mini
# سقف پنجرهٔ زمینهٔ مدل (توکن). کوچک‌ترین مقدار میان مدل‌های فعال را بگذارید؛
# اندازهٔ هر درخواست (متن + system prompt + خروجی) از همین عدد حساب می‌شود.
# پیش‌فرض، نصفِ پنجرهٔ ۲۶۲۱۴۴ توکنیِ هر دو مدل پیش‌فرض (agnes-2.5-flash در
# Nara و مدل ثابت OpenRouter) است تا برای سقف‌های اعلام‌نشدهٔ درگاه و برآورد
# محافظه‌کارانهٔ توکن فارسی حاشیه بماند؛ مدل دیگری گذاشتید، این عدد را با
# کوچک‌ترین پنجرهٔ مدل‌های فعال تنظیم کنید.
#NOTE_CONTEXT_TOKENS=131072
# full | standard | summary
#NOTE_MODE=full
# سقف توکن خروجی هر درخواست جزوه. این عدد *زمان* درخواست را تعیین می‌کند: مدل باید
# این تعداد توکن را بسازد و روی درگاه رایگان/مشترک سرعت کافی ندارد. اگر این سقف
# از مهلت پایین‌تر باشد، درخواست نه رد می‌شود و نه پاسخ می‌گیرد — فقط Timeout
# می‌خورد. برای مدل استدلالی، توکن‌های «تفکر» هم از همین سقف کم می‌شوند.
#NOTE_MAX_OUTPUT_TOKENS=16384
# راهنمای تنظیم: دست‌کم یک هفته از لاگ‌های Phase 0 مقدار output_tokens واقعی را
# جمع کنید، صدک ۹۵ (p95) را بگیرید و سقف را p95 + ۱۵٪ حاشیه بگذارید
# (مثال: 16384 -> 8192). هرگز پایین‌تر از p95 مشاهده‌شده نبرید؛ خطر ناقص‌شدن جزوه (truncation) دارد.
# مهلت (ثانیه) هر درخواست جزوه. اگر سرویس در این مدت پاسخ ندهد، درخواست تمام
# می‌شود و سرویس بعدیِ زنجیره امتحان می‌شود (همان درخواست دوباره فرستاده نمی‌شود).
# مقدارش باید از زمان لازم برای تولید NOTE_MAX_OUTPUT_TOKENS بیشتر باشد.
#NOTE_REQUEST_TIMEOUT_SECONDS=900
# پس از هر تغییر سقف توکن، این مهلت را دوباره حساب کنید: باید از زمان لازم برای
# تولید NOTE_MAX_OUTPUT_TOKENS روی کندترین مدل پیکربندی‌شده بیشتر باشد.
# پاسخ سرویس را به JSON محدود می‌کند (فقط وقتی سرویس پشتیبانی می‌کند؛ برای
# مدل ثابت پیش‌فرض OpenRouter می‌توانید true بگذارید، به Nara هرگز فرستاده نمی‌شود)
#NOTE_JSON_MODE=false
# فقط وقتی true کنید که مدل OpenRouter انتخابی json_object را مستند کرده باشد؛
# کد این حالت را هرگز به Nara نمی‌فرستد.
#NOTE_CHUNK_CHARS=64000
#NOTE_CONCURRENCY=3
# روی cPanel مقدار 3 بماند؛ روی VPS می‌توان 6 تا 8 گذاشت.
# گام دومِ ادغام بخش‌ها برای درس‌های بلند
#NOTE_COMPILE=true
# سقف نویسه‌های جزوهٔ ادغام‌شده در درخواست compile؛ ۰ یعنی خودکار از روی
# پنجرهٔ زمینه حساب شود (با سقف مطلقِ کد). عدد مثبت همان سقف دستی شماست.
#NOTE_COMPILE_MAX_CHARS=0
# سطح تلاش استدلال برای مسیرهای Nara، OpenRouter، Groq و Cerebras؛ خالی یعنی
# پیش‌فرض خود سرویس و هیچ فیلدی فرستاده نمی‌شود. مقادیر:
# none|minimal|low|medium|high|xhigh|max
#NOTE_REASONING_EFFORT=
# اگر استفاده می‌کنید با low شروع کنید (هرگز اول minimal نه)، قبل از نگه‌داشتن
# با گزارش quality-gate ‏A/B کنید؛ روی gpt-oss (Groq/Cerebras) مقدار low جلوی
# خرج‌شدن توکن‌های خروجی برای تفکر پنهان را می‌گیرد. به مسیرهای
# openai_compatible، gemini و anthropic هرگز فرستاده نمی‌شود.
# بررسی شواهد: هر عدد، واحد و اصطلاح جزوه با متن منبع مقایسه می‌شود؛ جدول و
# نکتهٔ کاربردی که در متن پشتوانه ندارد حذف می‌شود. false یعنی رفتار پیش از v4.
#NOTE_STRICT_GROUNDING=true
# repair | warn — repair یک درخواست اصلاحِ محدود می‌فرستد تا موارد جامانده
# برگردند؛ warn فقط بررسی و در لاگ ثبت می‌کند (برای هفتهٔ اولِ استقرار امن‌تر است).
#NOTE_QUALITY_GATE=repair

# ── عملکرد لایهٔ LLM (پیش‌فرض‌ها = رفتار فعلی) ─────────────────────────────
# سقف اتصال‌های هم‌زمان و به‌ازای هر میزبان در session مشترک.
#LLM_CONNECTOR_LIMIT=32
#LLM_CONNECTOR_LIMIT_PER_HOST=8
#LLM_CONNECTOR_TTL_DNS_CACHE=300
#LLM_CONNECTOR_KEEPALIVE=300
# گرم‌کردن یک اتصال به میزبان اولین سرویس جزوه پس از ساخت session (یک HEAD، بدون مصرف سهمیه).
#LLM_PREWARM=true
# نگهبان TTFB استریمینگ (ثانیه)؛ 0 = خاموش. فقط مسیرهای openai؛ در صورت سکوت، failover.
#NOTE_TTFB_TIMEOUT_SECONDS=0
# مسابقهٔ موازی دو سرویس پس از این تأخیر (ثانیه)؛ 0 = خاموش. حداکثر یک POST اضافه.
#NOTE_HEDGE_AFTER_SECONDS=0
# هم‌زمانی پردازش تکه‌های plan_deck در آفیس.
#OFFICE_AI_CONCURRENCY=3

# ── متن خام ─────────────────────────────────────────────────────────────────
# plain | timestamped  — قالب فایل .txt و پیش‌نمایش
#RAW_TEXT_PROFILE=plain

# ── آفیس رایگان (متن کاربر → Word/Excel/PowerPoint) ─────────────────────────
# این بخش رایگان است و از اعتبار کاربر چیزی کم نمی‌کند. اگر کلید سرویس تولید
# جزوه تنظیم نشده باشد، ساخت ارائه و جدول با ساختار قطعی متن کاربر انجام
# می‌شود و سند همیشه ساخته می‌شود.
# روشن/خاموش کردن کل بخش از منوی کاربر.
#OFFICE_ENABLED=true
# حداکثر حجم فایل متنی بارگذاری‌شده (بایت)؛ فایل بزرگ‌تر پذیرفته نمی‌شود.
#OFFICE_MAX_INPUT_BYTES=1000000
# حداکثر نویسه‌های متن یک سند.
#OFFICE_MAX_CHARS=20000
# حداکثر تعداد اسلاید یک ارائه.
#OFFICE_MAX_SLIDES=30
# عمر نشست «آفیس» به دقیقه؛ نشست بی‌استفاده پس از این مدت پاک می‌شود.
#OFFICE_SESSION_TTL_MINUTES=30

# ── اسلایدها ────────────────────────────────────────────────────────────────
#PRESENTATION_MAX_CLIPS=300
# سقف مدت فایل ادغام‌شده برای STT، با احتساب سکوت‌های افزوده‌شده بین کلیپ‌ها.
#PRESENTATION_MAX_TOTAL_DURATION=21600
#PRESENTATION_MAX_UNPACKED_BYTES=4294967296
# سقف مجموع فایل‌های موقت هر ارائه (فایل اصلی، رسانه‌های استخراج‌شده و خروجی).
#PRESENTATION_MAX_TEMP_BYTES=8589934592
#PRESENTATION_MIN_CLIP_SECONDS=0.5
#PRESENTATION_SILENCE_SECONDS=0.25
#PRESENTATION_WAV_LIMIT_BYTES=2147483648
#PRESENTATION_INCLUDE_SLIDE_TEXT=true
#PRESENTATION_INCLUDE_VIDEO_AUDIO=true
# رسانه‌های بدون رابطهٔ مستقیم با اسلاید به‌طور پیش‌فرض کنار گذاشته می‌شوند.
# برای واردکردنشان: true
#PRESENTATION_INCLUDE_UNREFERENCED_MEDIA=false

# ── پرداخت کارت‌به‌کارت ──────────────────────────────────────────────────────
# بدون شماره کارت، خرید بسته غیرفعال است و هیچ کارتی به‌صورت پیش‌فرض در کد نیست.
#PAYMENT_CARD_NUMBER=
#PAYMENT_CARD_HOLDER=
#PAYMENT_BANK_NAME=
#RECEIPT_DIR=data/receipts
#RECEIPT_RETENTION_DAYS=90
#MAX_PAYMENT_RECEIPT_BYTES=5242880

# ── تعرفه (تومان/ساعت/روز) ──────────────────────────────────────────────────
#FREE_PLAN_HOURS=1
#PLAN_5_HOURS=5
#PLAN_5_PRICE_TOMAN=50000
#PLAN_5_VALIDITY_DAYS=30
#PLAN_10_HOURS=10
#PLAN_10_PRICE_TOMAN=75000
#PLAN_10_VALIDITY_DAYS=30
#PLAN_20_HOURS=20
#PLAN_20_PRICE_TOMAN=130000
#PLAN_20_VALIDITY_DAYS=30
#PLAN_25_HOURS=25
#PLAN_25_PRICE_TOMAN=150000
#PLAN_25_VALIDITY_DAYS=30
#PLAN_50_HOURS=50
#PLAN_50_PRICE_TOMAN=250000
#PLAN_50_VALIDITY_DAYS=30
