# ─────────────────────────────────────────────────────────────────────────────
# Gamas Bot v3 — پیکربندی
#
# هر مقدار نسبی نسبت به پوشهٔ پروژه تفسیر می‌شود تا cron یا su نتواند ناخواسته
# پایگاه‌داده یا نشست دومی بسازد. کلیدهای سرویس‌ها فقط از همین فایل/محیط
# خوانده می‌شوند؛ هیچ کلیدی در پایگاه‌داده ذخیره نمی‌شود.
# ─────────────────────────────────────────────────────────────────────────────

# ── تلگرام (اجباری) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# نشست Telethon (پیش‌فرض: data/gamas)
#TELEGRAM_SESSION=data/gamas
# شناسه‌های عددی مدیرها، با ویرگول
ADMIN_IDS=

# ── مسیرها و لاگ ────────────────────────────────────────────────────────────
#DB_PATH=data/gamas_v3.db
#TEMP_DIR=data/tmp
#LOG_FILE=data/gamas.log
#LOG_LEVEL=INFO
#LOG_FORMAT=plain
#LOG_MAX_BYTES=5242880
#LOG_BACKUP_COUNT=5

# ── صف و زمان‌های انتظار ────────────────────────────────────────────────────
#MAX_FILE_SIZE=2147483648
#MAX_ACTIVE_JOBS=3
#MAX_QUEUED_JOBS=8
#MEDIA_TIMEOUT=3600
#CONVERT_TIMEOUT=600
#STT_JOB_TIMEOUT=21600
#STT_POLL_INTERVAL=10

# ── تبدیل گفتار به متن (حداقل یکی اجباری) ─────────────────────────────────
# ترتیب failover؛ فقط سرویس‌های دارای کلید امتحان می‌شوند.
#STT_PROVIDERS=speechmatics,deepgram,openai_compatible
#STT_LANGUAGE=fa

SPEECHMATICS_API_KEY=
#SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
# مدل‌های مجاز: enhanced (پیش‌فرض) | standard | melia-1 | oak-1
# دو مدل آخر چندزبانه‌اند، فقط Batch، و به‌جای زبان کد «multi» را می‌گیرند
# (STT_LANGUAGE=multi)؛ مقدار auto را رد می‌کنند.
#SPEECHMATICS_MODEL=enhanced
# سقف آپلود مستقیم Speechmatics ۱GB است (POST /jobs)؛ فایل بزرگ‌تر به موتور بعدی می‌رود.

#DEEPGRAM_API_KEY=
#DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
# فارسی فقط روی nova-3 پشتیبانی می‌شود؛ nova-2 زبان fa ندارد و درخواست را
# با HTTP 400 رد می‌کند.
#DEEPGRAM_MODEL=nova-3

# هر نقطهٔ پایانی سازگار با OpenAI:
#STT_OPENAI_BASE_URL=https://api.openai.com/v1
#STT_OPENAI_API_KEY=
#STT_OPENAI_MODEL=whisper-1
# Official OpenAI transcription API is limited to 25 MB; raise for a gateway
# that documents a larger limit.
#STT_OPENAI_MAX_UPLOAD_BYTES=25000000

# ── تولید جزوه (اختیاری؛ بدون آن فقط متن خام تحویل می‌شود) ─────────────────
# openai_compatible | gemini | anthropic
# OpenAI-compatible is the default; Gemini is selected automatically for a
# legacy GEMINI_API_KEY-only setup when NOTE_PROVIDER is not set. Anthropic
# deployments should set NOTE_MODEL explicitly (there is no built-in default).
#NOTE_PROVIDER=openai_compatible
#NOTE_API_KEY=
# نام جدید همان کلید: فقط وقتی NOTE_API_KEY و NOTE_BASE_URL تنظیم نشده باشند،
# GEMINI_API_KEY به‌طور خودکار سرویس gemini را انتخاب می‌کند.
#GEMINI_API_KEY=
#NOTE_BASE_URL=https://api.openai.com/v1
#NOTE_MODEL=gpt-4o-mini
# full | standard | summary
#NOTE_MODE=full
#NOTE_MAX_OUTPUT_TOKENS=16384
# پاسخ سرویس را به JSON محدود می‌کند (فقط وقتی سرویس پشتیبانی می‌کند)
#NOTE_JSON_MODE=false
#NOTE_CHUNK_CHARS=22000
#NOTE_CONCURRENCY=3
# گام دومِ ادغام بخش‌ها برای درس‌های بلند
#NOTE_COMPILE=true

# ── متن خام ─────────────────────────────────────────────────────────────────
# plain | timestamped  — قالب فایل .txt و پیش‌نمایش
#RAW_TEXT_PROFILE=plain

# ── اسلایدها ────────────────────────────────────────────────────────────────
#PRESENTATION_MAX_CLIPS=300
#PRESENTATION_MAX_TOTAL_DURATION=21600
#PRESENTATION_MAX_UNPACKED_BYTES=4294967296
#PRESENTATION_MIN_CLIP_SECONDS=0.5
#PRESENTATION_SILENCE_SECONDS=0.25
#PRESENTATION_WAV_LIMIT_BYTES=2147483648
#PRESENTATION_INCLUDE_SLIDE_TEXT=true
#PRESENTATION_INCLUDE_VIDEO_AUDIO=true

# ── پرداخت کارت‌به‌کارت ──────────────────────────────────────────────────────
#PAYMENT_CARD_NUMBER=
#PAYMENT_CARD_HOLDER=
#PAYMENT_BANK_NAME=
#RECEIPT_DIR=data/receipts
#RECEIPT_RETENTION_DAYS=90
#MAX_PAYMENT_RECEIPT_BYTES=5242880

# ── تعرفه (تومان/ساعت/روز) ──────────────────────────────────────────────────
#FREE_PLAN_HOURS=1
#PLAN_5_HOURS=5
#PLAN_5_PRICE_TOMAN=50000
#PLAN_5_VALIDITY_DAYS=30
#PLAN_10_HOURS=10
#PLAN_10_PRICE_TOMAN=75000
#PLAN_10_VALIDITY_DAYS=30
#PLAN_20_HOURS=20
#PLAN_20_PRICE_TOMAN=130000
#PLAN_20_VALIDITY_DAYS=30
#PLAN_25_HOURS=25
#PLAN_25_PRICE_TOMAN=150000
#PLAN_25_VALIDITY_DAYS=30
#PLAN_50_HOURS=50
#PLAN_50_PRICE_TOMAN=250000
#PLAN_50_VALIDITY_DAYS=30
