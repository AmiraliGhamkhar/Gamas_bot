# the complete standard catalog; payment snapshots always freeze the sale price.
#FREE_PLAN_HOURS=1
#PLAN_3_HOURS=3
#PLAN_3_ORIGINAL_PRICE_TOMAN=160000
#PLAN_3_PRICE_TOMAN=79000
#PLAN_3_VALIDITY_DAYS=30
#PLAN_6_HOURS=6
#PLAN_6_ORIGINAL_PRICE_TOMAN=200000
#PLAN_6_PRICE_TOMAN=99000
#PLAN_6_VALIDITY_DAYS=30
#PLAN_10_HOURS=10
#PLAN_10_ORIGINAL_PRICE_TOMAN=220000
#PLAN_10_PRICE_TOMAN=109000
#PLAN_10_VALIDITY_DAYS=30
#PLAN_20_HOURS=20
#PLAN_20_ORIGINAL_PRICE_TOMAN=360000
#PLAN_20_PRICE_TOMAN=179000
#PLAN_20_VALIDITY_DAYS=30
#PLAN_26_HOURS=26
#PLAN_26_ORIGINAL_PRICE_TOMAN=460000
#PLAN_26_PRICE_TOMAN=229000
#PLAN_26_VALIDITY_DAYS=30
#PLAN_30_HOURS=30
#PLAN_30_ORIGINAL_PRICE_TOMAN=600000
#PLAN_30_PRICE_TOMAN=299000
#PLAN_30_VALIDITY_DAYS=30
# 50-hour tier intentionally is not configured or sold until both prices are confirmed.

