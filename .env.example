# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# api_id و api_hash از my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# شناسه‌های عددی مدیرها، جداشده با کاما
ADMIN_IDS=123456789

# حداقل یکی از دو کلید زیر لازم است
SPEECHMATICS_API_KEY=
DEEPGRAM_API_KEY=
# موتور اصلی: speechmatics یا deepgram
STT_PRIMARY=speechmatics
STT_FALLBACK_ENABLED=true
# در صورت confidence کمتر از این مقدار، موتور جایگزین امتحان می‌شود
STT_MIN_CONFIDENCE=0.65
# فقط در صورت نیاز به تغییر منطقهٔ Speechmatics تنظیم شود
SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2
DEEPGRAM_MODEL=nova-3

# برای تولید جزوهٔ ساختاربندی‌شده؛ در نبود کلید متن خام فرستاده می‌شود
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

DATABASE_PATH=data/bot.sqlite3
TELEGRAM_SESSION_PATH=data/telegram_bot
TEMP_DIR=data/tmp
MAX_FILE_SIZE_BYTES=2000000000
MAX_CONCURRENT_JOBS=3
STT_POLL_INTERVAL_SECONDS=5
STT_JOB_TIMEOUT_SECONDS=21600

# --- پردازش فایل ارائه (PowerPoint) ---
# پذیرش فایل‌های pptx و استخراج صدای اسلایدها
PPTX_ENABLED=true
# استفاده از متن و یادداشت گویندهٔ اسلایدها در ساخت جزوه
PPTX_INCLUDE_SLIDE_TEXT=true
# استخراج صدا از ویدیوهای داخل اسلایدها (به ffmpeg نیاز دارد)
PPTX_INCLUDE_VIDEO_AUDIO=true
# پذیرش فایل‌های قدیمی ppt/pps/odp با تبدیل از طریق LibreOffice
PPTX_LEGACY_ENABLED=true
# کلیپ‌های کوتاه‌تر از این مقدار (ثانیه) نادیده گرفته می‌شوند؛ مثل صدای افکت اسلاید
PPTX_MIN_CLIP_SECONDS=1.0
# فاصلهٔ سکوت میان صدای اسلایدها هنگام ادغام (ثانیه)
PPTX_SILENCE_SECONDS=0.5
PPTX_MAX_CLIPS=300
# سقف مجموع مدت صداهای یک ارائه (ثانیه)
PPTX_MAX_TOTAL_DURATION_SECONDS=21600
# سقف حجم بازشدهٔ فایل ارائه برای جلوگیری از zip bomb
PPTX_MAX_UNPACKED_BYTES=4000000000
# اگر خروجی WAV بزرگ‌تر از این مقدار شود، به‌جای آن Opus ساخته می‌شود
PPTX_WAV_LIMIT_BYTES=700000000

# مسیر ابزارهای بیرونی؛ در صورت نبودن در PATH کامل وارد کنید
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SOFFICE_BIN=soffice
FFMPEG_TIMEOUT_SECONDS=3600
SOFFICE_TIMEOUT_SECONDS=600
