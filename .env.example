# Gamas Bot configuration. Copy to .env, fill the required values, keep it private.
#   Windows PowerShell: Copy-Item .env.example .env ; notepad .env
#   cPanel Terminal:    cp .env.example .env && chmod 600 .env && nano .env
# Relative paths resolve from the project directory. Keep .env and data/ outside public_html.
# Full guide: docs/CONFIGURATION.md

# --- Telegram (required) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated numeric Telegram user IDs.
ADMIN_IDS=
#TELEGRAM_SESSION=data/gamas

# --- Mandatory channel subscription ----------------------------------------
# Channel every user must join before protected bot features work. A numeric
# channel id (e.g. -1001234567890) or a public @username; the bot must be an
# administrator of that channel for getChatMember to resolve membership.
SUBSCRIPTION_CHANNEL=@gamas_AI
# true = verify membership on every protected interaction; false disables the
# gate entirely (administration/testing only). Admin IDs are always exempt.
SUBSCRIPTION_REQUIRED=true
# Reuse a confirmed membership for N seconds. 0 = verify on every interaction;
# 300 keeps a leaver gated within 5 minutes; failures are never cached.
SUBSCRIPTION_CACHE_SECONDS=300
# Timeout of each getChatMember call, in seconds.
SUBSCRIPTION_TIMEOUT_SECONDS=20
# Telegram Bot API base URL; override only behind a proxy.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Paths and logging -----------------------------------------------------
#DB_PATH=data/gamas_v3.db
#TEMP_DIR=data/tmp
#LOG_FILE=data/gamas.log
#LOG_LEVEL=INFO
# plain | json
#LOG_FORMAT=plain
#LOG_MAX_BYTES=5242880
#LOG_BACKUP_COUNT=5

# --- Queue and limits ------------------------------------------------------
#MAX_FILE_SIZE=134217728
# Ceiling for an uploaded study document that is parsed into text (PDF/DOCX/PPTX).
#DOC_MAX_BYTES=20971520
#DOC_UNPACKED_MAX_BYTES=104857600
#MAX_MEDIA_DURATION_SECONDS=7200
# Stage-gated active jobs; keep conservative on cPanel (2-3 overlaps network stages safely).
#MAX_ACTIVE_JOBS=3
#MAX_ACTIVE_JOBS_PER_USER=2
#MAX_QUEUED_JOBS=8
#MAX_CONCURRENT_DOWNLOADS=2
#MEDIA_WORKER_CONCURRENCY=1
#MAX_CONCURRENT_UPLOADS=2
#DOWNLOAD_TIMEOUT_SECONDS=900
#UPLOAD_TIMEOUT_SECONDS=600
#DEDUP_WINDOW_SECONDS=120
#MEDIA_TIMEOUT=3600
#CONVERT_TIMEOUT=600
#STT_JOB_TIMEOUT=21600
#STT_PROVIDER_TIMEOUT_SECONDS=1800
#STT_SLOT_WAIT_TIMEOUT_SECONDS=600
#STT_POLL_INTERVAL=10
#STT_STATUS_LONG_POLL=25
#STT_TRANSFER_TIMEOUT_SECONDS=600
#MAX_STT_RESPONSE_BYTES=67108864
#TEMP_MIN_FREE_BYTES=67108864
#DOWNLOAD_STALL_SECONDS=300
# Concurrent range downloads of one Telegram file; measure before raising.
#TELEGRAM_DOWNLOAD_CONNECTIONS=1
# auto | wav | opus
#AUDIO_FORMAT_POLICY=auto

# --- Speech to text (at least one provider) --------------------------------
# Primary Speechmatics, non-blocking overflow/failover to Deepgram.
#STT_PROVIDERS=speechmatics,deepgram,openai_compatible
#STT_FALLBACK_ENABLED=true
#STT_LANGUAGE=fa
# Clean the audio before it is uploaded: highpass (rumble), spectral denoise
# (hiss), per-window level (near/far lecturer) and a limiter. Sample-exact, so
# the charged duration is still the uploaded one. Set to false only to compare
# raw recognition quality.
#STT_PREPROCESS=true
# Ask the engine who spoke, and split the transcript by conversation turns.
# Engines that cannot diarize ignore it; a run that resolves to a single voice is
# delivered without speaker labels. 0 = least sensitive (fewest speakers),
# 1 = most sensitive.
#STT_DIARIZE=true
#STT_SPEAKER_SENSITIVITY=0.5

SPEECHMATICS_API_KEY=
#SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
# enhanced | standard | melia-1 | oak-1 (multi)
#SPEECHMATICS_MODEL=enhanced
#SPEECHMATICS_MAX_IN_FLIGHT=2

#DEEPGRAM_API_KEY=
#DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
# Persian needs Nova-3; nova-2 has no fa language pack.
#DEEPGRAM_MODEL=nova-3
#DEEPGRAM_MAX_IN_FLIGHT=4

# Any OpenAI-compatible transcription endpoint.
#STT_OPENAI_BASE_URL=https://api.openai.com/v1
#STT_OPENAI_API_KEY=
#STT_OPENAI_MODEL=whisper-1
#STT_OPENAI_MAX_UPLOAD_BYTES=25000000
#STT_OPENAI_MAX_IN_FLIGHT=2

# --- Note generation (optional for audio; Office has local fallbacks) ------
# Order is the failover policy; providers without their own key are skipped.
#
# TESTED DEPLOYMENT PROFILE (2026-11-07) — deployment-specific, NOT shipped
# defaults. Verified by real metadata and generation tests at one deployment
# (see docs/PROVIDERS.md). Uncomment this whole block only after your own
# metadata checks and controlled generation probes succeed. No credentials are
# included here: fill the GEMINI_API_KEY and OPENROUTER_API_KEY lines below.
#NOTE_PROVIDERS=gemini,openrouter
#NOTE_STRUCTURED_OUTPUT=0
#NOTE_REASONING_EFFORT=none
#NOTE_MAX_OUTPUT_TOKENS=32768
#NOTE_GEMINI_THINKING_BUDGET=-1
#GEMINI_MODEL=gemini-3.5-flash-lite
#OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
#
# NaraRouter stays fully configurable (NARA_API_KEY, NARA_BASE_URL,
# NARA_MODEL) but is deliberately absent from that chain: laguna-s-2.1 failed
# three real generation attempts with HTTP 502, also with structured output
# and reasoning disabled. Model entitlement is not a generation guarantee.
# Leave NOTE_API_KEY and NOTE_BASE_URL unchanged/blank when using this profile:
# a configured legacy base URL is treated as an extra OpenAI-compatible route.
#
# Shipped PROJECT-WIDE defaults, shown for reference. All lines in this file
# are comments: enable either this set OR the tested profile above, never both.
#NOTE_PROVIDERS=gemini,nara,openrouter,deepseek,avalai

#NARA_API_KEY=
#NARA_BASE_URL=https://router.bynara.id/v1
#NARA_MODEL=agnes-2.5-flash

#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_MODEL=google/gemma-4-31b-it:free

#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash-lite
# 0 disables Gemini thinking, a positive value caps it, -1 sends no
# thinkingConfig field at all (the tested profile uses -1).
#NOTE_GEMINI_THINKING_BUDGET=0

#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL=deepseek-flash

# AvalAI, an OpenAI-compatible gateway (https://docs.avalai.ir). Its DeepSeek
# entry supports json_schema output and implicit prompt caching, so the static
# note prompt is billed at the cached-input rate from the second request on.
#AVALAI_API_KEY=
#AVALAI_BASE_URL=https://api.avalai.ir/v1
#AVALAI_MODEL=deepseek-v4.1-flash

# Legacy single-provider slot; a dedicated provider key is preferred.
# or gemini | anthropic | nara | ...
#NOTE_PROVIDER=openai_compatible
#NOTE_BASE_URL=https://api.openai.com/v1
#NOTE_API_KEY=
# Required for Anthropic; defaults to the provider's default model otherwise.
#NOTE_MODEL=gpt-4o-mini

# Context window of the smallest configured model (tokens).
#NOTE_CONTEXT_TOKENS=131072
# Deprecated / no-op: only FULL booklets are produced; any value is ignored.
#NOTE_MODE=full
# Shipped default is 16384; the tested deployment profile uses 32768.
# A running bot reads this only at startup: restart after changing it.
#NOTE_MAX_OUTPUT_TOKENS=16384
# Must exceed the time needed to emit NOTE_MAX_OUTPUT_TOKENS; the 32768 profile
# produces an advisory WARN at the shipped 900 s deadline (measure first).
#NOTE_REQUEST_TIMEOUT_SECONDS=900
#NOTE_CHUNK_CHARS=64000
#NOTE_CONCURRENCY=3
#LLM_PRIMARY_MAX_IN_FLIGHT=4
#LLM_FALLBACK_MAX_IN_FLIGHT=4
#LLM_SLOT_WAIT_TIMEOUT_SECONDS=300
#NOTE_JSON_MODE=false
# none|minimal|low|medium|high|xhigh|max (empty = provider default)
# "none" is sent as reasoning_effort only on routes that document the field
# (NaraRouter/OpenRouter/DeepSeek); Gemini uses its own thinking budget.
#NOTE_REASONING_EFFORT=
#NOTE_OPENROUTER_THROUGHPUT=1
# Shipped default 1 sends responseSchema/json_schema. The tested Gemini and
# OpenRouter deployment uses 0: JSON is still requested by the prompt and by
# Gemini's responseMimeType, then strictly parsed and domain-validated.
#NOTE_STRUCTURED_OUTPUT=1
#NOTE_PROGRESSIVE_BOOKLET=1
#NOTE_COMPILE_PROVIDER=
#NOTE_COMPILE=true
# 0 = derive from the context window
#NOTE_COMPILE_MAX_CHARS=0
#NOTE_STRICT_GROUNDING=true
# Re-scan the draft for gaps using bounded, source-grounded fill requests.
#NOTE_COMPLETENESS_FILL=true
# repair | warn
#NOTE_QUALITY_GATE=repair

# --- Note HTTP layer -------------------------------------------------------
#LLM_CONNECTOR_LIMIT=32
#LLM_CONNECTOR_LIMIT_PER_HOST=8
#LLM_CONNECTOR_TTL_DNS_CACHE=300
#LLM_CONNECTOR_KEEPALIVE=300
#LLM_PREWARM=true
#NOTE_TTFB_TIMEOUT_SECONDS=25
#NOTE_HEDGE_AFTER_SECONDS=60
#OFFICE_AI_CONCURRENCY=3

# --- Raw transcript --------------------------------------------------------
# plain | timestamped
#RAW_TEXT_PROFILE=plain
#RAW_FALLBACK_FILE_CHARS=100000
#RAW_FALLBACK_MAX_FILES=8

# --- Telegram-backed personal library ------------------------------------
# Keep the newest delivered booklets per user.
LIBRARY_MAX_ITEMS=50

# --- Learning loop (quiz and AI flashcards; credit charged in seconds) ----
# Cost per generated quiz question (a 10-question quiz costs 10x this).
#QUIZ_COST_SECONDS_PER_QUESTION=60
# An active quiz untouched for longer than this many hours expires lazily.
#QUIZ_MAX_ACTIVE_HOURS=6
# Maximum quiz sessions one user may create in any rolling hour.
#QUIZ_MAX_SESSIONS_PER_HOUR=3
# Credit charged before generating one AI flashcard deck.
#FLASHCARD_AI_COST_SECONDS=300
# Number of question/answer pairs requested per AI deck (minimum valid 5).
#FLASHCARD_AI_DECK_SIZE=10
# Maximum stored decks per user, AI and manual counted together.
#FLASHCARD_MAX_DECKS_PER_USER=30
# Maximum manual cards in one deck.
#FLASHCARD_MAX_CARDS_PER_DECK=200
# Parallel per-chunk model calls inside one generation (3-5 is the useful range).
#LEARNING_CHUNK_CONCURRENCY=4
# Learning output token budget per provider call.
#LEARNING_MAX_OUTPUT_TOKENS=4096

# --- Free Office -----------------------------------------------------------
# Free exports for pasted text/messages and .txt/.md/.markdown/.csv/.tsv files,
# plus full/compact Word+PDF notes and exports for extracted PDF/DOCX/PPTX sources.
OFFICE_ENABLED=true
OFFICE_MAX_INPUT_BYTES=1000000
OFFICE_MAX_CHARS=100000
OFFICE_MAX_SLIDES=30
OFFICE_SESSION_TTL_MINUTES=30
OFFICE_JOB_CONCURRENCY=2
OFFICE_AI_CONCURRENCY=3
# 0 disables the per-user creation throttle; Office actions never use wallet credit.
OFFICE_MIN_INTERVAL_SECONDS=10

# --- OCR for scans and photos (opt-in, third party) ------------------------
# Off by default: when enabled, the page images of a text-poor PDF (or a photo
# the user sends) are uploaded to i2ocr.com. Review its current privacy terms.
# From the project root install the extra: python -m pip install '.[ocr]'.
# See docs/OCR.md for setup, privacy and page/time limits.
OCR_ENABLED=false
# i2ocr language slug (persian, english, arabic, kazakh, ...); `fa` works too.
OCR_LANGUAGE=persian
# Most pages of one document sent to the service (0 = every page).
OCR_MAX_PAGES=20
# Wall-clock budget for one document's OCR run, in seconds.
OCR_TIMEOUT_SECONDS=600

# --- PowerPoint decks ------------------------------------------------------
#PRESENTATION_MAX_CLIPS=50
#PRESENTATION_MAX_TOTAL_DURATION=7200
#PRESENTATION_MAX_UNPACKED_BYTES=134217728
#PRESENTATION_MAX_TEMP_BYTES=268435456
#PRESENTATION_MIN_CLIP_SECONDS=0.5
#PRESENTATION_SILENCE_SECONDS=0.25
#PRESENTATION_WAV_LIMIT_BYTES=134217728
#PRESENTATION_INCLUDE_SLIDE_TEXT=true
#PRESENTATION_INCLUDE_VIDEO_AUDIO=true
#PRESENTATION_INCLUDE_UNREFERENCED_MEDIA=false

# --- Card-to-card payments (manual admin review) ---------------------------
# Set all three payment details to enable purchases.
#PAYMENT_CARD_NUMBER=
#PAYMENT_CARD_HOLDER=
#PAYMENT_BANK_NAME=
#RECEIPT_DIR=data/receipts
#RECEIPT_RETENTION_DAYS=90
#MAX_PAYMENT_RECEIPT_BYTES=5242880
# 0 = keep forever
#TRANSCRIPT_RETENTION_DAYS=0
# Optional retention (0 = keep forever).
#DOCUMENT_RETENTION_DAYS=0
#LEARNING_RETENTION_DAYS=0
#AUDIT_RETENTION_DAYS=0
#HOLDS_RETENTION_DAYS=0

# --- Tariff (toman / hours / days) ----------------------------------------
# The credit is the user-facing unit: 100,000 credits = 3 hours of audio,
# so 360,000 credits = 1 hour (the ledger stays integer seconds).
# Canonical price: 100,000 credits = 60000 toman (20000 toman per hour).
#FREE_PLAN_HOURS=1
#PLAN_3_HOURS=3
#PLAN_3_PRICE_TOMAN=60000
#PLAN_3_VALIDITY_DAYS=30
#PLAN_9_HOURS=9
#PLAN_9_PRICE_TOMAN=180000
#PLAN_9_VALIDITY_DAYS=30
#PLAN_12_HOURS=12
#PLAN_12_PRICE_TOMAN=240000
#PLAN_12_VALIDITY_DAYS=30
#PLAN_24_HOURS=24
#PLAN_24_PRICE_TOMAN=480000
#PLAN_24_VALIDITY_DAYS=30
#PLAN_36_HOURS=36
#PLAN_36_PRICE_TOMAN=720000
#PLAN_36_VALIDITY_DAYS=30
#PLAN_60_HOURS=60
#PLAN_60_PRICE_TOMAN=1200000
#PLAN_60_VALIDITY_DAYS=30

# --- Support admission ------------------------------------------------------
#SUPPORT_MAX_OPEN_TICKETS=3
#SUPPORT_TICKET_COOLDOWN_SECONDS=600

# 2 GB cPanel profile (recommended starting point; uncomment to apply):
#MAX_ACTIVE_JOBS=3
#MAX_QUEUED_JOBS=6
#MEDIA_WORKER_CONCURRENCY=1
#MAX_CONCURRENT_DOWNLOADS=2
#TELEGRAM_DOWNLOAD_CONNECTIONS=1
#NOTE_CONCURRENCY=3
#LEARNING_CHUNK_CONCURRENCY=2
#LEARNING_GLOBAL_CONCURRENCY=2
#SUBSCRIPTION_CACHE_SECONDS=300
#NOTE_HEDGE_AFTER_SECONDS=60
#DOC_MAX_BYTES=20971520
