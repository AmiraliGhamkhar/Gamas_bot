[Unit]
Description=دستیار تلگرامی تبدیل صوت به جزوه
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/gamas-bot
EnvironmentFile=/opt/gamas-bot/.env
ExecStart=/opt/gamas-bot/.venv/bin/python -m gamas_bot
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/gamas-bot/data

[Install]
WantedBy=multi-user.target
