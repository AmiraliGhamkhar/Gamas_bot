[Unit]
Description=دستیار تلگرامی تبدیل صوت به جزوه
Documentation=https://github.com/AmiraliGhamkhar/Gamas_bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/gamas-bot
EnvironmentFile=/opt/gamas-bot/.env
Environment=PYTHONUNBUFFERED=1
# No system office/media binaries are used; media work runs in Python child
# processes. A writable HOME keeps Python cache paths valid for a home-less
# system account.
Environment=HOME=/opt/gamas-bot/data
Environment=XDG_CACHE_HOME=/opt/gamas-bot/data/.cache
# Ensure the private data directory exists (0700) before strict mount
# namespacing runs, and do not restart-loop on fatal misconfiguration (2) or
# duplicate-instance lock exit (3).
ExecStartPre=+/usr/bin/install -d -m 0700 -o bot -g bot /opt/gamas-bot/data
ExecStart=/opt/gamas-bot/.venv/bin/python -m gamas_bot
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077

# Basic hardening. The bot only needs write access to data/.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/opt/gamas-bot/data

# Output is collected by journald. Keep LOG_FILE empty unless a rotated file is desired.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamas-bot

[Install]
WantedBy=multi-user.target
