[Unit]
Description=دستیار تلگرامی تبدیل صوت به جزوه
Documentation=https://github.com/AmiraliGhamkhar/Gamas_bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/gamas-bot
EnvironmentFile=/opt/gamas-bot/.env
Environment=PYTHONUNBUFFERED=1
# LibreOffice/fontconfig need a writable home/cache even in headless mode.
Environment=HOME=/opt/gamas-bot/data
Environment=XDG_CACHE_HOME=/opt/gamas-bot/data/.cache
ExecStart=/opt/gamas-bot/.venv/bin/python -m gamas_bot
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
KillSignal=SIGINT
UMask=0077

# Basic hardening. The bot only needs write access to data/.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gamas-bot/data

# Output is collected by journald. Keep LOG_FILE empty unless a rotated file is desired.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamas-bot

[Install]
WantedBy=multi-user.target
